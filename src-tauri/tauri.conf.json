{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbit Shadow",
  "version": "0.1.1",
  "identifier": "cloud.orbit-shadow.launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Orbit Shadow",
        "width": 640,
        "height": 480,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/chromium": "chromium"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0MjUyQTA1RDJGODgwNDQKUldSRWdQalNCU29sRkJzN3ZuNTVFdU16M09UU3ZUeU5ZZ3pIbWdIai9ZeU5BcmNXVEs2QUtnOHgK",
      "endpoints": [
        "https://play.orbit-shadow.cloud/launcher/latest.json"
      ]
    }
  }
}
