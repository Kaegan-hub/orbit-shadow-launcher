{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbit Shadow",
  "version": "0.1.6",
  "identifier": "cloud.orbit-shadow.launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Orbit Shadow",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "maximized": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "../game-shell/main.js": "game-shell/main.js",
      "../game-shell/package.json": "game-shell/package.json",
      "../game-shell/flash": "game-shell/flash",
      "../game-shell/node_modules": "game-shell/node_modules"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxQzJCMDY4MzREMTg5NkEKUldScWlkRTBhTERDOGEvVzZ1SlRVU1hBUk5HNFByVHhidUdLT044dTMzTmRmeWo1QzE5WEI4TlEK",
      "endpoints": [
        "https://play.orbit-shadow.cloud/launcher/latest.json"
      ]
    }
  }
}
